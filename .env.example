# Where the viewer gets trains: mock (simulated, the default) or live (CTA Train Tracker through the proxy)
VITE_TRAIN_SOURCE=mock
# Live only: the URL of the deployed proxy (proxy/worker.ts)
VITE_TRAIN_PROXY_URL=
# Proxy secret, set with `npx wrangler secret put CTA_TRAIN_TRACKER_KEY`. Never commit it.
CTA_TRAIN_TRACKER_KEY=
