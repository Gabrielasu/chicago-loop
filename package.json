{
  "name": "chicago-loop",
  "private": true,
  "type": "module",
  "workspaces": [
    "mock",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "test": "vitest run",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc -p mock --noEmit && tsc -p web --noEmit",
    "samples": "node mock/scripts/samples.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
